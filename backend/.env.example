# ==========================================
# Face Mask Detection Backend Configuration
# ==========================================

# Server settings
HOST=0.0.0.0
PORT=8000

# Path to the trained Keras model (relative to backend directory or absolute path)
MODEL_PATH=model/mask_detector.keras

# Target input dimensions for MobileNetV2 (Member 1's model input size)
IMG_SIZE=224

# Class names corresponding to model output classes (comma-separated, in index order)
# Index 0: Mask, Index 1: Without Mask
CLASS_NAMES=Mask,Without Mask

# CORS Allowed Origins (comma-separated) for Member 2's React frontend
# Default includes typical Vite (5173) and Create-React-App (3000) dev ports
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
